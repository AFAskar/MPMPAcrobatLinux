# Local environment overrides for the Windows Acrobat reference harness.
# Copy this file to `.env` (gitignored) and uncomment any settings you need.
# Explicit shell environment variables always take precedence over `.env`.
# Set `MPMB_ENV_FILE=/path/to/custom.env` to load a different file, or
# `MPMB_ENV_FILE=""` to disable `.env` loading completely.

# Windows VM SSH / SCP connection
# MPMB_WIN_USER=mpmb-test
# MPMB_WIN_HOST=127.0.0.1
# MPMB_WIN_PORT=2222
# MPMB_WIN_SCP_TARGET=mpmb-test@127.0.0.1
# MPMB_WIN_ROOT=C:\Users\mpmb-test\MPMB-Testing
# MPMB_WIN_SSH_KEY=~/.ssh/mpmb_win_vm

# Local libvirt domain name and SSH multiplex/lock directory
# MPMB_VM_NAME=mpmb-windows11
# MPMB_MUX_DIR=~/.cache/mpmb-testing

# Optional Python interpreter with tools/acrobat/requirements.txt installed
# MPMB_PYTHON=.venv/bin/python3
